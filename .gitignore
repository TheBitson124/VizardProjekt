# ==========================================
# 1. Vizard & Basilisk Simulation Specifics
# ==========================================
# Exclude recorded simulation files (.bin data generated during run)
*.bin
outputs/
_VizFiles/
tmp/
reports/

# Exclude custom asset bundles and large 3D models (keep sources (.obj/.fbx) if needed, but ignore bulky builds)
*.unitypackage
*.assetbundle
*.meta

# ==========================================
# 2. Python & Compiled Files
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# 3. Virtual Environments
# ==========================================
# Exclude your local environment so others can use their own
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ==========================================
# 4. IDE and Editor Settings
# ==========================================
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / JetBrains
.idea/

# General / OS files
.DS_Store
Thumbs.db
*.log